# Dockerfile para Grafana en Render.com
# Este Dockerfile es SOLO para Grafana, NO para la API NestJS

FROM grafana/grafana:latest

# Instalar plugin Infinity (reemplazo de JSON API, permite conectar a APIs REST/JSON)
# Este plugin permite conectar Grafana a tu API sin necesidad de plugins de pago
RUN grafana-cli plugins install yesoreyeram-infinity-datasource

# Exponer el puerto de Grafana (Render.com usa PORT automáticamente)
EXPOSE 3000

# Variables de entorno por defecto (pueden ser sobrescritas en Render.com)
ENV GF_SECURITY_ADMIN_USER=admin
ENV GF_SECURITY_ADMIN_PASSWORD=admin
ENV GF_SERVER_HTTP_PORT=3000
ENV GF_SERVER_ROOT_URL=/
ENV GF_SERVER_SERVE_FROM_SUB_PATH=false

# Grafana se inicia automáticamente con el CMD de la imagen base
# No necesitamos especificar CMD porque grafana/grafana:latest ya lo tiene

